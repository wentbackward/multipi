#!/usr/bin/env bash
# A stand-in for the GitHub CLI, for the smoke tests. Offline, no network.
#
# PRs live in $FAKE_GH_DIR as flat files: <head-slug>.title / .body / .state
# (slug: branch name with "/" replaced by "_"). A squash merge is a real
# `git merge --squash` into a fresh clone of the bare origin, honouring
# --match-head-commit when given. Every call is appended to calls.log as
# `gh repo=<effective> <args>` — the effective repo this call would hit: the --repo
# flag, else $GH_REPO, else `-` (the git-remote guess the real CLI falls back to is
# not emulated offline).
#
# Issues live in $FAKE_GH_DIR/issues (open) and issues-closed, one file per
# number (line 1 title, line 2 body); labels in labels/<n>.
# Comments live in comments/<n>/<seq> (seq zero-padded, one file per message):
# `issue view <n> --json …comments` emits the REAL shape — one array entry per
# comment, oldest first, [] when the issue has none (the pre-#105 blob form
# collapsed the whole history into a single comment, which made per-comment
# bookkeeping like the should-fix round count untestable).
#
# Test seam: while $FAKE_GH_DIR/<slug>.merge-hold exists, `pr merge` refuses the
# merge and the PR stays OPEN (a temporarily blocked PR, e.g. failing CI) — this
# lets the smoke test stop a merge train deterministically mid-train.
#
# Supported surface (everything the multipi scripts and extension call):
#   auth status
#   pr view <branch> [--json state]        0 open, 1 none
#   pr list --head <branch> --json state   0 always ([] when no PR)
#     --json number round-trips offline too: PRs are allocated numbers at create (starting at
#     100, persisted in <dir>/pr-seq) — a stand-in of the real CLI's numbering.
#     --state open|closed|merged|all is HONORED with the real CLI's default:
#     WITHOUT --state only OPEN PRs are listed — a MERGED PR is invisible
#     unless the caller asks for all (or merged).
#   pr create --head B --title T [--body-file F]
#   pr merge|squash-merge <branch> [--match-head-commit SHA]
#   issue create (--title T [--body B]|<title> [body])   prints issue URL (both forms:
#     the FLAG form is the real CLI's contract (positionals are rejected by `gh`);
#     the positional form is kept for the shell-driven smoke lines)
#   issue list --state open|closed --json <fields>
#     the REQUESTED fields are honoured: of number/title/labels/body, only the
#     ones named in --json are emitted (unknown fields are ignored), so a body
#     containing JSON-shaped text can never pollute a --json number query.
#   issue view <n> --json <fields>
#     "state" emits "OPEN"/"CLOSED" (open dir vs issues-closed dir); "labels" emits
#     the attached labels (labels/<n>, [] when none); "comments" emits the real
#     comments array; "title" is always included.
#   issue edit <n> --add-label <l> [--remove-label <l2>]
#     the real CLI's label semantics: re-adding a carried label is a no-op (dedupe),
#     and removing a label the issue does not carry is a no-op (rc 0).
#   issue close <n> [--comment <c>]
#   api repos/<owner>/<repo>/issues/<n>/timeline [--paginate --slurp]
#     the label-event timeline, for blocked-age detection (ticket #104): one line
#     per event in <dir>/timeline/<n> shaped "<created_at ISO8601> <label-name>";
#     emits [{"event":"labeled","created_at":"<iso>","label":{"name":"<l>"}}, …]
#     ([] when the file is absent). Any other api ref is unsupported (rc 1).
#   issue list --json …updatedAt
#     the row's "updatedAt": <dir>/ts/<n> line 1 when present, else the
#     documented default 2026-01-01T00:00:00Z (the real CLI always returns one).
#
# `issue list --json` emits the REAL CLI shape: ONE compact array line
# ([{...},{...}], or [] when empty), not one object per line.
# Failure seams for fail-open tests (off unless set to 1): FAKE_GH_FAIL_ISSUE_LIST
# and FAKE_GH_FAIL_PR_LIST make the matching subcommand fail like a transient 502.
#
# JSON strings escape backslash and double quote; the issue BODY in
# `issue list --json` spans the remainder of the issue file, and its newlines
# are encoded as \n (line-join applied AFTER the quoting, so escaped
# backslashes survive). All other values stay single-line (a deliberate,
# documented limit of the fake).
#
# Tracker is not an actor: the Layer-2 git/gh shims (scripts/policy-shims) policy-check
# every invocation they front. The REAL `gh` is a compiled binary — its server-side merge
# never re-enters the bash PATH shims — so this fake emulates that: with a policy-shims
# dir on PATH, its INTERNAL git calls (the squash emulation clones + pushes as the
# "server") run unshimmed, or the emulated push would be classified as a foreign
# mutation and the P5 full-train acceptance could never merge.
set -u
case ":$PATH:" in
  *"/policy-shims:"*)
    IFS=: read -r -a _entries <<<"$PATH"
    _np=""
    for _e in "${_entries[@]}"; do
      case "/${_e%/}" in */policy-shims) continue ;; esac
      [ -n "$_e" ] || continue
      _np=${_np:+$_np:}$_e
    done
    [ -n "$_np" ] && export PATH="$_np"    # server-side git, never the shielded session PATH
    ;;
esac
dir=${FAKE_GH_DIR:?FAKE_GH_DIR not set}
mkdir -p "$dir" "$dir/issues" "$dir/issues-closed" "$dir/labels" "$dir/ts" "$dir/timeline"
gh_repo="${GH_REPO:--}"
prev_arg=""
for a in "$@"; do
  [ "$prev_arg" = "--repo" ] && gh_repo=$a
  prev_arg=$a
done
printf 'gh repo=%s%s\n' "$gh_repo" "${*:+ $*}" >>"$dir/calls.log"
key() { printf '%s' "${1//\//_}"; }
jesc() { printf '%s' "${1:-}" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# global --repo FLAG VALUE: the extension pins the repo explicitly; the fake ignores it
# beyond recording the EFFECTIVE repo (flag > $GH_REPO env > "-"). Documented limit:
# only the space form --repo VALUE is recognised (all loop callers use it); the
# --repo=VALUE form would be recorded as unset.
if [ "${1:-}" = "--repo" ]; then shift 2; fi

# documented failure seams (see header): simulate a transient tracker failure
if [ "${1:-} ${2:-}" = "issue list" ] && [ "${FAKE_GH_FAIL_ISSUE_LIST:-}" = 1 ]; then
  echo "fake gh: simulated transient failure (issue list)" >&2; exit 1
fi
if [ "${1:-} ${2:-}" = "pr list" ] && [ "${FAKE_GH_FAIL_PR_LIST:-}" = 1 ]; then
  echo "fake gh: simulated transient failure (pr list)" >&2; exit 1
fi

# `api repos/<owner>/<repo>/issues/<n>/timeline` is dispatched before the $1/$2 case
# below (which matches "cmd subcmd" and would never see the bare "api" word):
case "${1:-}" in
  api)
    # Flags (--paginate --slurp, ticket #104's newest-event pagination) may precede the
    # ref; the fake is single-page and honours none of them beyond RECORDING them in
    # calls.log (the pins key off that recording, the pagination is the REAL client's).
    shift
    ref=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --*) : ;;
        *) ref=${1:-}; break ;;
      esac
      shift
    done
    case "$ref" in
      repos/*/issues/*/timeline)
        rest=${ref#*/issues/}
        n=${rest%%/*}
        events="[]"
        if [ -f "$dir/timeline/$n" ]; then
          events="["
          first=1
          while read -r iso lab; do
            [ -n "$iso" ] || continue
            [ "$first" = 1 ] || events="$events,"
            events="$events{\"event\":\"labeled\",\"created_at\":\"$(jesc "$iso")\",\"label\":{\"name\":\"$(jesc "$lab")\"}}"
            first=0
          done <"$dir/timeline/$n"
          events="$events]"
        fi
        printf '%s\n' "$events"
        ;;
      *) echo "fake gh: unsupported api ref: $ref" >&2; exit 1 ;;
    esac
    exit 0
    ;;
esac

case "${1:-} ${2:-}" in
  "auth status")
    exit 0
    ;;
  "pr view")
    branch=$3
    [ -f "$dir/$(key "$branch").state" ] || exit 1
    case "${5:-}" in
      state) cat "$dir/$(key "$branch").state" ;;
    esac
    ;;
  "pr create")
    shift 2
    head="" title="" body_file=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --head) head=$2; shift 2 ;;
        --title) title=$2; shift 2 ;;
        --body-file) body_file=$2; shift 2 ;;
        *) shift ;;
      esac
    done
    printf '%s\n' "$title" >"$dir/$(key "$head").title"
    [ -f "$body_file" ] && cp "$body_file" "$dir/$(key "$head").body"
    echo OPEN >"$dir/$(key "$head").state"
    if [ ! -f "$dir/$(key "$head").number" ]; then
      seq_file="$dir/pr-seq"
      seq_next=100
      [ -f "$seq_file" ] && seq_next=$((10#$(sed -n 1p "$seq_file")))
      printf '%s\n' "$((seq_next + 1))" >"$seq_file"
      printf '%s\n' "$seq_next" >"$dir/$(key "$head").number"
    fi
    ;;
  "pr merge"|"pr squash-merge")
    branch=$3
    [ -f "$dir/$(key "$branch").merge-hold" ] && { echo "fake gh: merge held for $branch" >&2; exit 1; }
    origin=$(git remote get-url origin)
    expected=""
    [[ " $* " == *" --match-head-commit "* ]] && expected=$(printf '%s\n' "$@" | grep -A1 -- --match-head-commit | tail -1)
    work=$(mktemp -d)
    git clone -q "$origin" "$work/clone"
    (
      cd "$work/clone" || exit 1
      [ -z "$(git status --porcelain)" ] || { echo "fake gh: dirty clone" >&2; exit 1; }
      [ -z "$expected" ] || [ "$(git rev-parse "origin/$branch" 2>/dev/null)" = "$expected" ] ||
        { echo "fake gh: head moved" >&2; exit 1; }
      git merge -q --squash "origin/$branch" >/dev/null
      git commit -q -m "$(cat "$dir/$(key "$branch").title")"
      git push -q origin HEAD:main
    ) || { rm -rf "$work"; exit 1; }
    rm -rf "$work"
    echo MERGED >"$dir/$(key "$branch").state"
    ;;
  "issue comment")
    n=$3
    shift 3
    body=""
    while [ $# -gt 0 ]; do
      case $1 in
        --body) body=$2; shift 2 ;;
        *) shift ;;
      esac
    done
    mkdir -p "$dir/comments/$n"
    seq=1
    for f in "$dir/comments/$n"/*; do
      [ -e "$f" ] || continue
      cand=$((10#$(basename "$f")))
      [ "$cand" -ge "$seq" ] && seq=$((cand + 1))
    done
    printf '%s\n' "$body" >"$dir/comments/$n/$(printf '%04d' "$seq")"
    ;;
  "issue create")
    title=""
    body=""
    if [ "${3:-}" = "--title" ]; then
      # Flag form (the real CLI's contract): --title T [--body B].
      while [ $# -gt 0 ]; do
        case "$1" in
          --title|--body)
            [ $# -ge 2 ] || { echo "fake-gh: $1 requires an argument" >&2; exit 1; }
            if [ "$1" = "--title" ]; then title=$2; else body=$2; fi
            shift 2
            ;;
          *) shift ;;
        esac
      done
    else
      # Positional form, kept for the shell-driven smoke (the real gh rejects it).
      title=$3
      body=${4:-}
    fi
    n=1
    for d in "$dir/issues" "$dir/issues-closed"; do
      for f in "$d"/*; do
        [ -e "$f" ] || continue
        cand=$((10#$(basename "$f")))
        [ "$cand" -ge "$n" ] && n=$((cand + 1))
      done
    done
    printf '%s\n%s\n' "$title" "$body" >"$dir/issues/$n"
    echo "https://github.com/fake/repo/issues/$n"
    ;;
  "pr list")
    head=""
    pstate=open
    json=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --head) head=$2; shift 2 ;;
        --state) pstate=$2; shift 2 ;;
        --json) json=$2; shift 2 ;;
        *) shift ;;
      esac
    done
    st=""
    [ -f "$dir/$(key "$head").state" ] && st=$(sed -n 1p "$dir/$(key "$head").state")
    show=0
    [ -n "$st" ] && case $pstate in
      all) show=1 ;;
      open) [ "$st" = OPEN ] && show=1 ;;
      closed) [ "$st" = CLOSED ] && show=1 ;;
      merged) [ "$st" = MERGED ] && show=1 ;;
    esac
    numfield=""
    case ",$json," in
      *,number,*)
        [ -f "$dir/$(key "$head").number" ] && numfield="\"number\":$(sed -n 1p "$dir/$(key "$head").number"),"
        ;;
    esac
    [ "$show" = 1 ] && printf '[{%s"state":"%s"}]\n' "$numfield" "$st" || printf '[]\n'
    ;;
  "issue list")
    state=open json=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --state) state=$2; shift 2 ;;
        --json) json=$2; shift 2 ;;
        --limit) shift 2 ;;
        *) shift ;;
      esac
    done
    src=$dir/issues
    [ "$state" = closed ] && src=$dir/issues-closed
    # Honour the REQUESTED --json fields (real CLI contract): of
    # number/title/labels/body, only the named ones are emitted. Emitting
    # unrequested body text into a --json number query would let JSON-shaped
    # bodies interfere with number extractors.
    want_field() { case ,$json, in *",$1,"*) return 0 ;; *) return 1 ;; esac; }
    items=""
    for f in $(find "$src" -mindepth 1 -maxdepth 1 ! -name '.*' -printf '%f\n' 2>/dev/null | sort -n); do
      if [ -n "$json" ]; then
        obj='{"number":'$f
        if want_field title; then
          obj="$obj,\"title\":\"$(jesc "$(sed -n 1p "$src/$f")")\""
        fi
        if want_field labels; then
          labs="[]"
          if [ -f "$dir/labels/$f" ]; then
            labs=$(awk '{printf "%s{\"name\":\"%s\"}", (NR>1?",":""), $0}' "$dir/labels/$f")
            labs="[$labs]"
          fi
          obj="$obj,\"labels\":$labs"
        fi
        if want_field body; then
          # The body is the REMAINDER of the file (multi-line round-trips): quote it
          # first, then encode newlines as literal \n so the value stays single-line.
          body=$(jesc "$(sed -n '2,$p' "$src/$f")" | awk '{printf "%s%s", (NR>1?"\\n":""), $0}')
          obj="$obj,\"body\":\"$body\""
        fi
        if want_field updatedAt; then
          uat="2026-01-01T00:00:00Z"   # documented default (the real CLI always returns one)
          [ -f "$dir/ts/$f" ] && uat=$(sed -n 1p "$dir/ts/$f")
          obj="$obj,\"updatedAt\":\"$(jesc "$uat")\""
        fi
        obj="$obj}"
        [ -z "$items" ] || items="$items,"  # compact single line, real-CLI shape
        items="$items$obj"
      else
        echo "#$f $(sed -n 1p "$src/$f")"
      fi
    done
    [ -n "$json" ] && printf '[%s]\n' "$items"
    exit 0
    ;;
  "issue view")
    n=$3
    fields=${5:-title}
    state=""
    title=$(sed -n 1p "$dir/issues/$n" 2>/dev/null)
    if [ -n "$title" ]; then
      state=OPEN
    else
      title=$(sed -n 1p "$dir/issues-closed/$n" 2>/dev/null)
      [ -n "$title" ] && state=CLOSED
    fi
    [ -n "$title" ] || exit 1
    out="{\"title\":\"$(jesc "$title")\""
    case ",$fields," in *,state,*) out="$out,\"state\":\"$state\"" ;; esac
    case ",$fields," in *,labels,*)
      labs="[]"
      [ -f "$dir/labels/$n" ] && labs="[$(awk '{printf "%s{\"name\":\"%s\"}", (NR>1?",":""), $0}' "$dir/labels/$n")]"
      out="$out,\"labels\":$labs"
      ;;
    esac
    if [ -z "${fields##*comments}" ]; then
      cmts="[]"
      if [ -d "$dir/comments/$n" ]; then
        cmts="["
        first=1
        for f in $(find "$dir/comments/$n" -mindepth 1 -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | sort); do
          # Newlines are encoded as literal \n AFTER the quote/backslash escaping: a comment
          # is a SINGLE JSON string, the same contract the issue BODY in `issue list` follows.
          body_nl=$(jesc "$(cat "$dir/comments/$n/$f")" | awk '{printf "%s%s", (NR>1?"\\n":""), $0}')
          [ "$first" = 1 ] || cmts="$cmts,"
          cmts="$cmts{\"body\":\"$body_nl\"}"
          first=0
        done
        cmts="$cmts]"
      fi
      out="$out,\"comments\":$cmts"
    fi
    printf '%s}\n' "$out"
    ;;
  "issue edit")
    n=$3
    shift 3
    while [ $# -gt 0 ]; do
      case "$1" in
        --add-label)
          # Real CLI dedupes: re-adding a carried label is a no-op (duplicate lines in
          # labels/<n> would poison every label read downstream).
          if ! grep -qxF "$2" "$dir/labels/$n" 2>/dev/null; then
            echo "$2" >>"$dir/labels/$n"
          fi
          shift 2 ;;
        --remove-label)
          # Real CLI: removing a label the issue does not carry is a no-op (rc 0).
          if [ -f "$dir/labels/$n" ]; then
            grep -vxF "$2" "$dir/labels/$n" >"$dir/labels/$n.rm" || true
            mv "$dir/labels/$n.rm" "$dir/labels/$n"
          fi
          shift 2 ;;
        *) shift ;;
      esac
    done
    ;;
  "issue close")
    n=$3
    [ -f "$dir/issues/$n" ] || exit 1
    mv "$dir/issues/$n" "$dir/issues-closed/$n"
    echo "closed #$n"
    ;;
  *) echo "fake gh: unsupported: $*" >&2; exit 1 ;;
esac
