#!/usr/bin/env bash
# A stand-in for the GitHub CLI, for the smoke tests. Offline, no network.
#
# PRs live in $FAKE_GH_DIR as flat files: <head-slug>.title / .body / .state
# (slug: branch name with "/" replaced by "_"). A squash merge is a real
# `git merge --squash` into a fresh clone of the bare origin, honouring
# --match-head-commit when given. Every call is appended to calls.log.
#
# Issues live in $FAKE_GH_DIR/issues (open) and issues-closed, one file per
# number (line 1 title, line 2 body); labels in labels/<n>.
#
# Test seam: while $FAKE_GH_DIR/<slug>.merge-hold exists, `pr merge` refuses the
# merge and the PR stays OPEN (a temporarily blocked PR, e.g. failing CI) — this
# lets the smoke test stop a merge train deterministically mid-train.
#
# Supported surface (everything the multipi scripts and extension call):
#   auth status
#   pr view <branch> [--json state]        0 open, 1 none
#   pr list --head <branch> --json state   0 always ([] when no PR)
#     --state open|closed|merged|all is HONORED with the real CLI's default:
#     WITHOUT --state only OPEN PRs are listed — a MERGED PR is invisible
#     unless the caller asks for all (or merged).
#   pr create --head B --title T [--body-file F]
#   pr merge|squash-merge <branch> [--match-head-commit SHA]
#   issue create <title> [body]            prints issue URL
#   issue list --state open|closed --json <fields>
#     the REQUESTED fields are honoured: of number/title/labels/body, only the
#     ones named in --json are emitted (unknown fields are ignored), so a body
#     containing JSON-shaped text can never pollute a --json number query.
#   issue view <n> --json <fields>
#   issue edit <n> --add-label <l>
#   issue close <n> [--comment <c>]
#
# `issue list --json` emits the REAL CLI shape: ONE compact array line
# ([{...},{...}], or [] when empty), not one object per line.
# Failure seams for fail-open tests (off unless set to 1): FAKE_GH_FAIL_ISSUE_LIST
# and FAKE_GH_FAIL_PR_LIST make the matching subcommand fail like a transient 502.
#
# JSON strings escape backslash and double quote; the issue BODY in
# `issue list --json` spans the remainder of the issue file, and its newlines
# are encoded as \n (line-join applied AFTER the quoting, so escaped
# backslashes survive). All other values stay single-line (a deliberate,
# documented limit of the fake).
set -u
dir=${FAKE_GH_DIR:?FAKE_GH_DIR not set}
mkdir -p "$dir" "$dir/issues" "$dir/issues-closed" "$dir/labels"
echo "gh $*" >>"$dir/calls.log"
key() { printf '%s' "${1//\//_}"; }
jesc() { printf '%s' "${1:-}" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# global --repo FLAG VALUE: the extension pins the repo explicitly; the fake ignores it
if [ "${1:-}" = "--repo" ]; then shift 2; fi

# documented failure seams (see header): simulate a transient tracker failure
if [ "${1:-} ${2:-}" = "issue list" ] && [ "${FAKE_GH_FAIL_ISSUE_LIST:-}" = 1 ]; then
  echo "fake gh: simulated transient failure (issue list)" >&2; exit 1
fi
if [ "${1:-} ${2:-}" = "pr list" ] && [ "${FAKE_GH_FAIL_PR_LIST:-}" = 1 ]; then
  echo "fake gh: simulated transient failure (pr list)" >&2; exit 1
fi

case "${1:-} ${2:-}" in
  "auth status")
    exit 0
    ;;
  "pr view")
    branch=$3
    [ -f "$dir/$(key "$branch").state" ] || exit 1
    case "${5:-}" in
      state) cat "$dir/$(key "$branch").state" ;;
    esac
    ;;
  "pr create")
    shift 2
    head="" title="" body_file=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --head) head=$2; shift 2 ;;
        --title) title=$2; shift 2 ;;
        --body-file) body_file=$2; shift 2 ;;
        *) shift ;;
      esac
    done
    printf '%s\n' "$title" >"$dir/$(key "$head").title"
    [ -f "$body_file" ] && cp "$body_file" "$dir/$(key "$head").body"
    echo OPEN >"$dir/$(key "$head").state"
    ;;
  "pr merge"|"pr squash-merge")
    branch=$3
    [ -f "$dir/$(key "$branch").merge-hold" ] && { echo "fake gh: merge held for $branch" >&2; exit 1; }
    origin=$(git remote get-url origin)
    expected=""
    [[ " $* " == *" --match-head-commit "* ]] && expected=$(printf '%s\n' "$@" | grep -A1 -- --match-head-commit | tail -1)
    work=$(mktemp -d)
    git clone -q "$origin" "$work/clone"
    (
      cd "$work/clone" || exit 1
      [ -z "$(git status --porcelain)" ] || { echo "fake gh: dirty clone" >&2; exit 1; }
      [ -z "$expected" ] || [ "$(git rev-parse "origin/$branch" 2>/dev/null)" = "$expected" ] ||
        { echo "fake gh: head moved" >&2; exit 1; }
      git merge -q --squash "origin/$branch" >/dev/null
      git commit -q -m "$(cat "$dir/$(key "$branch").title")"
      git push -q origin HEAD:main
    ) || { rm -rf "$work"; exit 1; }
    rm -rf "$work"
    echo MERGED >"$dir/$(key "$branch").state"
    ;;
  "issue comment")
    n=$3
    shift 3
    body=""
    while [ $# -gt 0 ]; do
      case $1 in
        --body) body=$2; shift 2 ;;
        *) shift ;;
      esac
    done
    mkdir -p "$dir/comments"
    printf '%s\n' "$body" >>"$dir/comments/$n"
    ;;
  "issue create")
    title=$3
    body=${4:-}
    n=1
    for d in "$dir/issues" "$dir/issues-closed"; do
      for f in "$d"/*; do
        [ -e "$f" ] || continue
        cand=$((10#$(basename "$f")))
        [ "$cand" -ge "$n" ] && n=$((cand + 1))
      done
    done
    printf '%s\n%s\n' "$title" "$body" >"$dir/issues/$n"
    echo "https://github.com/fake/repo/issues/$n"
    ;;
  "pr list")
    head=""
    pstate=open
    while [ $# -gt 0 ]; do
      case "$1" in
        --head) head=$2; shift 2 ;;
        --state) pstate=$2; shift 2 ;;
        *) shift ;;
      esac
    done
    st=""
    [ -f "$dir/$(key "$head").state" ] && st=$(sed -n 1p "$dir/$(key "$head").state")
    show=0
    [ -n "$st" ] && case $pstate in
      all) show=1 ;;
      open) [ "$st" = OPEN ] && show=1 ;;
      closed) [ "$st" = CLOSED ] && show=1 ;;
      merged) [ "$st" = MERGED ] && show=1 ;;
    esac
    [ "$show" = 1 ] && printf '[{"state":"%s"}]\n' "$st" || printf '[]\n'
    ;;
  "issue list")
    state=open json=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --state) state=$2; shift 2 ;;
        --json) json=$2; shift 2 ;;
        --limit) shift 2 ;;
        *) shift ;;
      esac
    done
    src=$dir/issues
    [ "$state" = closed ] && src=$dir/issues-closed
    # Honour the REQUESTED --json fields (real CLI contract): of
    # number/title/labels/body, only the named ones are emitted. Emitting
    # unrequested body text into a --json number query would let JSON-shaped
    # bodies interfere with number extractors.
    want_field() { case ,$json, in *",$1,"*) return 0 ;; *) return 1 ;; esac; }
    items=""
    for f in $(find "$src" -mindepth 1 -maxdepth 1 ! -name '.*' -printf '%f\n' 2>/dev/null | sort -n); do
      if [ -n "$json" ]; then
        obj='{"number":'$f
        if want_field title; then
          obj="$obj,\"title\":\"$(jesc "$(sed -n 1p "$src/$f")")\""
        fi
        if want_field labels; then
          labs="[]"
          if [ -f "$dir/labels/$f" ]; then
            labs=$(awk '{printf "%s{\"name\":\"%s\"}", (NR>1?",":""), $0}' "$dir/labels/$f")
            labs="[$labs]"
          fi
          obj="$obj,\"labels\":$labs"
        fi
        if want_field body; then
          # The body is the REMAINDER of the file (multi-line round-trips): quote it
          # first, then encode newlines as literal \n so the value stays single-line.
          body=$(jesc "$(sed -n '2,$p' "$src/$f")" | awk '{printf "%s%s", (NR>1?"\\n":""), $0}')
          obj="$obj,\"body\":\"$body\""
        fi
        obj="$obj}"
        [ -z "$items" ] || items="$items,"  # compact single line, real-CLI shape
        items="$items$obj"
      else
        echo "#$f $(sed -n 1p "$src/$f")"
      fi
    done
    [ -n "$json" ] && printf '[%s]\n' "$items"
    exit 0
    ;;
  "issue view")
    n=$3
    fields=${5:-title}
    title=$(sed -n 1p "$dir/issues/$n" 2>/dev/null)
    [ -n "$title" ] || title=$(sed -n 1p "$dir/issues-closed/$n" 2>/dev/null)
    [ -n "$title" ] || exit 1
    if [ -n "${fields##*comments}" ]; then
      printf '{"title":"%s"}\n' "$(jesc "$title")"
    else
      body=""
      [ -f "$dir/comments/$n" ] && body=$(awk '{line=line (NR>1?"\n":"") $0} END{print line}' "$dir/comments/$n")
      printf '{"title":"%s","comments":[{"body":"%s"}]}\n' "$(jesc "$title")" "$(jesc "$body")"
    fi
    ;;
  "issue edit")
    n=$3
    shift 3
    while [ $# -gt 0 ]; do
      case "$1" in
        --add-label) echo "$2" >>"$dir/labels/$n"; shift 2 ;;
        *) shift ;;
      esac
    done
    ;;
  "issue close")
    n=$3
    [ -f "$dir/issues/$n" ] || exit 1
    mv "$dir/issues/$n" "$dir/issues-closed/$n"
    echo "closed #$n"
    ;;
  *) echo "fake gh: unsupported: $*" >&2; exit 1 ;;
esac
