#!/usr/bin/env bash
# Stand-in for: pi -p --no-session --mode json [--append-system-prompt F] [--tools ...] [--model M] TASK...
# FAKE_PI_MODE: ok (default) | fail | slow. Streams the NDJSON events the real pi emits in JSON mode.
set -u
mode=${FAKE_PI_MODE:-ok}
sleep_s=${FAKE_PI_SLEEP:-0.1}
task=""
for a in "$@"; do task="$task $a"; done
emit() { printf '%s\n' "$1"; }
if [ "$mode" = slow ]; then
  trap 'exit 143' TERM
  sleep "$sleep_s" &
  wait $! || exit 143
fi
if [ "$mode" = fail ]; then
  echo "fake-pi: model blew up" >&2
  exit 3
fi
# FAKE_PI_HANG=1: emit ONE event, then hang forever, immune to SIGTERM —
# the watchdog scenario (a child wedged inside a tool call whose subprocess never returns).
if [ "${FAKE_PI_HANG:-}" = "1" ]; then
  emit "{\"type\":\"message_end\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"kicked off the long tool call...\"}],\"model\":\"fake/model\",\"stopReason\":\"end\",\"usage\":{\"input\":5,\"output\":5,\"cacheRead\":0,\"cacheWrite\":0,\"cost\":{\"total\":0.0005},\"totalTokens\":10}}}"
  bash -c 'trap "" TERM; sleep 300' &
  wait $!
  exit 0
fi
# FAKE_PI_LEAK_PIDFILE=F: simulate a child that leaks a long-lived grandchild
# (a TERM-immune background loop, i.e. the abandoned browser), then exits cleanly.
if [ -n "${FAKE_PI_LEAK_PIDFILE:-}" ]; then
  bash -c 'trap "" TERM; while :; do sleep 0.2; done' &
  echo $! >"$FAKE_PI_LEAK_PIDFILE"
fi
# Simulate an honest implementer: if the brief carries a notes-file instruction, write the notes file.
note=$(printf '%s' "$task" | grep -oE 'Notes file \(outside git, do NOT commit\): [^ ]+' | head -1 | sed 's/.*: //')
if [ -n "$note" ]; then
  mkdir -p "$(dirname "$note")"
  tno=$(printf '%s' "$task" | grep -oE 'Implement ticket #[0-9]+' | head -1 | grep -oE '[0-9]+')
  printf 'fake: implemented ticket #%s\n\n## Summary\nFake implementer did the work (offline test).\n\nCloses #%s\n\n## Test evidence\nfake: none\n' "${tno:-?}" "${tno:-?}" >"$note"
  # The child's cwd IS its worktree: produce one real commit and push the branch.
  if git rev-parse --git-dir >/dev/null 2>&1; then
    echo "fake: work" >"fake-evidence.txt"
    git add -A
    git commit -qm "fake: implement (Refs #${tno:-0})" || true
    git push -qu origin HEAD >/dev/null 2>&1 || true
  fi
fi
emit "{\"type\":\"tool_result_end\",\"message\":{\"role\":\"toolResult\",\"toolName\":\"bash\",\"content\":[{\"type\":\"text\",\"text\":\"ls\"}],\"details\":null}}"
emit "{\"type\":\"message_end\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Ran the task. Tests pass.\\n\\nSTATUS: DONE\"}],\"model\":\"fake/model\",\"stopReason\":\"end\",\"usage\":{\"input\":10,\"output\":20,\"cacheRead\":0,\"cacheWrite\":0,\"cost\":{\"total\":0.001},\"totalTokens\":30}}}"
if [ -n "${FAKE_PI_ECHO_ENV:-}" ]; then
  printf "%s" "${MULTIPI_CHILD:-unset}" >"$FAKE_PI_ECHO_ENV"
fi
if [ -n "${FAKE_PI_ECHO_TASK:-}" ]; then
  task=${task#?}
  esc=${task//\"/\\\"}
  emit "{\"type\":\"message_end\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"TASK WAS: $esc\"}],\"model\":\"fake/model\",\"stopReason\":\"end\",\"usage\":{\"input\":1,\"output\":1,\"cacheRead\":0,\"cacheWrite\":0,\"cost\":{\"total\":0},\"totalTokens\":2}}}"
fi
exit 0
